Project scheduler {
  database_type: 'MySQL'
  Note: 'MariaDB 11.4. Generated by `php artisan db:snapshot`; do not edit by hand.'
}

Enum rooms_room_type {
  "lecture"
  "laboratory"
  "venue"
}

Enum users_role {
  "admin"
  "registrar"
  "dean"
  "teacher"
  "learner"
}

Enum email_audits_method {
  "self_service"
  "admin"
}

Enum learners_status {
  "active"
  "inactive"
  "graduated"
  "dropped_out"
}

Enum absence_excuses_reason {
  "medical"
  "illness"
  "school_activity"
  "other"
}

Enum absence_excuses_status {
  "pending"
  "approved"
  "partial"
  "rejected"
  "revoked"
}

Enum teachers_duty_status {
  "active"
  "on_leave"
}

Enum terms_semester {
  "first"
  "second"
  "summer"
}

Enum enrollments_status {
  "enrolled"
  "for_dropping"
  "dropped"
}

Enum enrollments_drop_reason {
  "absences"
  "withdrawn"
  "removed"
}

Enum excuse_decisions_status {
  "pending"
  "approved"
  "declined"
  "revoked"
}

Enum schedules_mode {
  "onsite"
  "online"
}

Enum attendance_records_status {
  "present"
  "late"
  "absent"
}

Enum attendance_audits_old_status {
  "present"
  "late"
  "absent"
}

Enum attendance_audits_new_status {
  "present"
  "late"
  "absent"
}

Enum term_registrations_status {
  "registered"
  "withdrawn"
}

Table cache {
  key varchar(255) [pk, not null]
  value mediumtext [not null]
  expiration bigint(20) [not null]

  indexes {
    expiration [name: 'cache_expiration_index']
  }
}

Table cache_locks {
  key varchar(255) [pk, not null]
  owner varchar(255) [not null]
  expiration bigint(20) [not null]

  indexes {
    expiration [name: 'cache_locks_expiration_index']
  }
}

Table colleges {
  id "bigint(20) unsigned" [pk, increment, not null]
  code varchar(20) [not null]
  name varchar(150) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    code [unique, name: 'colleges_code_unique']
    name [unique, name: 'colleges_name_unique']
  }
}

Table failed_jobs {
  id "bigint(20) unsigned" [pk, increment, not null]
  uuid varchar(255) [not null]
  connection varchar(255) [not null]
  queue varchar(255) [not null]
  payload longtext [not null]
  exception longtext [not null]
  failed_at timestamp [not null, default: `current_timestamp()`]

  indexes {
    (connection, queue, failed_at) [name: 'failed_jobs_connection_queue_failed_at_index']
    uuid [unique, name: 'failed_jobs_uuid_unique']
  }
}

Table job_batches {
  id varchar(255) [pk, not null]
  name varchar(255) [not null]
  total_jobs int(11) [not null]
  pending_jobs int(11) [not null]
  failed_jobs int(11) [not null]
  failed_job_ids longtext [not null]
  options mediumtext [null]
  cancelled_at int(11) [null]
  created_at int(11) [not null]
  finished_at int(11) [null]
}

Table jobs {
  id "bigint(20) unsigned" [pk, increment, not null]
  queue varchar(255) [not null]
  payload longtext [not null]
  attempts "smallint(5) unsigned" [not null]
  reserved_at "int(10) unsigned" [null]
  available_at "int(10) unsigned" [not null]
  created_at "int(10) unsigned" [not null]

  indexes {
    queue [name: 'jobs_queue_index']
  }
}

Table notifications {
  id uuid [pk, not null]
  type varchar(255) [not null]
  notifiable_type varchar(255) [not null]
  notifiable_id "bigint(20) unsigned" [not null]
  data text [not null]
  read_at timestamp [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (notifiable_type, notifiable_id) [name: 'notifications_notifiable_type_notifiable_id_index']
  }
}

Table password_reset_tokens {
  email varchar(255) [pk, not null]
  token varchar(255) [not null]
  created_at timestamp [null]
}

Table programs {
  id "bigint(20) unsigned" [pk, increment, not null]
  college_id "bigint(20) unsigned" [not null]
  code varchar(20) [not null]
  name varchar(150) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    code [unique, name: 'programs_code_unique']
    college_id [name: 'programs_college_id_foreign']
  }
}

Table rooms {
  id "bigint(20) unsigned" [pk, increment, not null]
  code varchar(30) [not null]
  name varchar(100) [null]
  building varchar(100) [null]
  floor tinyint(4) [null]
  capacity "smallint(5) unsigned" [null]
  room_type rooms_room_type [not null, default: 'lecture']
  is_active tinyint(1) [not null, default: 1]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    code [unique, name: 'rooms_code_unique']
    name [unique, name: 'rooms_name_unique']
  }
}

Table sessions {
  id varchar(255) [pk, not null]
  user_id "bigint(20) unsigned" [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  payload longtext [not null]
  last_activity int(11) [not null]

  indexes {
    last_activity [name: 'sessions_last_activity_index']
    user_id [name: 'sessions_user_id_index']
  }
}

Table subjects {
  id "bigint(20) unsigned" [pk, increment, not null]
  college_id "bigint(20) unsigned" [not null]
  code varchar(20) [not null]
  title varchar(150) [not null]
  lecture_units decimal(3,1) [not null, default: 0.0]
  laboratory_units decimal(3,1) [not null, default: 0.0]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (college_id, code) [unique, name: 'subjects_college_id_code_unique']
  }
}

Table users {
  id "bigint(20) unsigned" [pk, increment, not null]
  role users_role [not null, default: 'learner']
  college_id "bigint(20) unsigned" [null]
  is_active tinyint(1) [not null, default: 1]
  last_name varchar(100) [not null]
  first_name varchar(100) [not null]
  middle_name varchar(100) [null]
  suffix varchar(20) [null, note: 'e.g. Jr., III']
  email varchar(255) [not null]
  email_verified_at timestamp [null]
  password varchar(255) [not null]
  two_factor_secret text [null]
  two_factor_recovery_codes text [null]
  two_factor_confirmed_at timestamp [null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (college_id, role) [name: 'users_college_id_role_index']
    email [unique, name: 'users_email_unique']
  }
}

Table calendar_events {
  id "bigint(20) unsigned" [pk, increment, not null]
  college_id "bigint(20) unsigned" [null, note: 'NULL = campus-wide']
  title varchar(150) [not null]
  description text [null]
  starts_on date [not null]
  ends_on date [not null]
  suspends_classes tinyint(1) [not null, default: 1]
  suspends_from time [null]
  suspends_until time [null]
  memo_number varchar(60) [null]
  memo_path varchar(255) [null]
  memo_name varchar(255) [null]
  created_by "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    college_id [name: 'calendar_events_college_id_foreign']
    created_by [name: 'calendar_events_created_by_foreign']
    (starts_on, ends_on) [name: 'calendar_events_starts_on_ends_on_index']
  }

  Note: '''
  CHECK chk_calendar_events_dates: `ends_on` >= `starts_on`
  '''
}

Table email_audits {
  id "bigint(20) unsigned" [pk, increment, not null]
  user_id "bigint(20) unsigned" [not null]
  old_email varchar(255) [not null]
  new_email varchar(255) [not null]
  method email_audits_method [not null]
  changed_by "bigint(20) unsigned" [null]
  reason varchar(255) [null]
  changed_at timestamp [not null, default: `current_timestamp()`]

  indexes {
    changed_by [name: 'email_audits_changed_by_foreign']
    (user_id, changed_at) [name: 'email_audits_user_id_changed_at_index']
  }
}

Table email_changes {
  id "bigint(20) unsigned" [pk, increment, not null]
  user_id "bigint(20) unsigned" [not null]
  new_email varchar(255) [not null]
  expires_at timestamp [not null]
  new_confirmed_at timestamp [null]
  old_approved_at timestamp [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    expires_at [name: 'email_changes_expires_at_index']
    user_id [unique, name: 'email_changes_user_id_unique']
  }
}

Table learners {
  id "bigint(20) unsigned" [pk, increment, not null]
  user_id "bigint(20) unsigned" [not null]
  program_id "bigint(20) unsigned" [not null]
  student_number varchar(30) [not null]
  year_level "tinyint(3) unsigned" [not null]
  status learners_status [not null, default: 'active']
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    program_id [name: 'learners_program_id_foreign']
    student_number [unique, name: 'learners_student_number_unique']
    user_id [unique, name: 'learners_user_id_unique']
  }
}

Table absence_excuses {
  id "bigint(20) unsigned" [pk, increment, not null]
  learner_id "bigint(20) unsigned" [not null]
  date_from date [not null]
  date_to date [not null]
  reason absence_excuses_reason [not null]
  remarks text [null]
  status absence_excuses_status [not null, default: 'pending']
  submitted_by "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (learner_id, status) [name: 'absence_excuses_learner_id_status_index']
    submitted_by [name: 'absence_excuses_submitted_by_foreign']
  }

  Note: '''
  CHECK chk_absence_excuses_dates: `date_to` >= `date_from`
  '''
}

Table absence_excuse_documents {
  id "bigint(20) unsigned" [pk, increment, not null]
  absence_excuse_id "bigint(20) unsigned" [not null]
  path varchar(255) [not null]
  original_name varchar(255) [not null]
  mime_type varchar(100) [not null]
  size_bytes "int(10) unsigned" [not null]
  uploaded_by "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    absence_excuse_id [name: 'absence_excuse_documents_absence_excuse_id_foreign']
    uploaded_by [name: 'absence_excuse_documents_uploaded_by_foreign']
  }
}

Table passkeys {
  id "bigint(20) unsigned" [pk, increment, not null]
  user_id "bigint(20) unsigned" [not null]
  name varchar(255) [not null]
  credential_id varchar(255) [not null]
  credential json [not null]
  last_used_at timestamp [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    credential_id [unique, name: 'passkeys_credential_id_unique']
    user_id [name: 'passkeys_user_id_index']
  }
}

Table teachers {
  id "bigint(20) unsigned" [pk, increment, not null]
  user_id "bigint(20) unsigned" [not null]
  employee_number varchar(30) [not null]
  duty_status teachers_duty_status [not null, default: 'active']
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    employee_number [unique, name: 'teachers_employee_number_unique']
    user_id [unique, name: 'teachers_user_id_unique']
  }
}

Table terms {
  id "bigint(20) unsigned" [pk, increment, not null]
  school_year char(9) [not null]
  semester terms_semester [not null]
  starts_on date [not null]
  ends_on date [not null]
  closed_at timestamp [null]
  closed_by "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    closed_by [name: 'terms_closed_by_foreign']
    (school_year, semester) [unique, name: 'terms_school_year_semester_unique']
  }

  Note: '''
  CHECK chk_terms_dates: `ends_on` > `starts_on`
  '''
}

Table attendance_policies {
  id "bigint(20) unsigned" [pk, increment, not null]
  term_id "bigint(20) unsigned" [not null]
  lates_per_absence "tinyint(3) unsigned" [not null, default: 3]
  drop_at_absences "tinyint(3) unsigned" [not null, default: 5]
  warn_at_absences json [not null, note: 'Ascending equivalent-absence counts that trigger a warning, e.g. [3,4]']
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    term_id [unique, name: 'attendance_policies_term_id_unique']
  }

  Note: '''
  CHECK chk_attendance_policies_positive: `lates_per_absence` > 0 and `drop_at_absences` > 0
  '''
}

Table sections {
  id "bigint(20) unsigned" [pk, increment, not null]
  term_id "bigint(20) unsigned" [not null]
  program_id "bigint(20) unsigned" [not null]
  year_level "tinyint(3) unsigned" [not null]
  name varchar(30) [not null]
  capacity "smallint(5) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    program_id [name: 'sections_program_id_foreign']
    (term_id, program_id, name) [unique, name: 'sections_term_id_program_id_name_unique']
  }
}

Table subject_offerings {
  id "bigint(20) unsigned" [pk, increment, not null]
  section_id "bigint(20) unsigned" [not null]
  subject_id "bigint(20) unsigned" [not null]
  teacher_id "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (section_id, subject_id) [unique, name: 'subject_offerings_section_id_subject_id_unique']
    subject_id [name: 'subject_offerings_subject_id_foreign']
    teacher_id [name: 'subject_offerings_teacher_id_foreign']
  }
}

Table batches {
  id "bigint(20) unsigned" [pk, increment, not null]
  subject_offering_id "bigint(20) unsigned" [not null]
  name varchar(30) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (subject_offering_id, name) [unique, name: 'batches_subject_offering_id_name_unique']
  }
}

Table enrollments {
  id "bigint(20) unsigned" [pk, increment, not null]
  learner_id "bigint(20) unsigned" [not null]
  subject_offering_id "bigint(20) unsigned" [not null]
  batch_id "bigint(20) unsigned" [null]
  status enrollments_status [not null, default: 'enrolled']
  warning_level "tinyint(3) unsigned" [not null, default: 0]
  flagged_for_drop_at timestamp [null]
  drop_confirmed_at timestamp [null]
  drop_confirmed_by "bigint(20) unsigned" [null]
  drop_reason enrollments_drop_reason [null]
  drop_dismissed_at timestamp [null]
  drop_dismissed_by "bigint(20) unsigned" [null]
  drop_dismissed_absences "tinyint(3) unsigned" [null]
  reinstated_at timestamp [null]
  reinstated_by "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    batch_id [name: 'enrollments_batch_id_foreign']
    drop_confirmed_by [name: 'enrollments_drop_confirmed_by_foreign']
    drop_dismissed_by [name: 'enrollments_drop_dismissed_by_foreign']
    (learner_id, subject_offering_id) [unique, name: 'enrollments_learner_id_subject_offering_id_unique']
    reinstated_by [name: 'enrollments_reinstated_by_foreign']
    (subject_offering_id, status) [name: 'enrollments_subject_offering_id_status_index']
  }
}

Table excuse_decisions {
  id "bigint(20) unsigned" [pk, increment, not null]
  absence_excuse_id "bigint(20) unsigned" [not null]
  subject_offering_id "bigint(20) unsigned" [not null]
  status excuse_decisions_status [not null, default: 'pending']
  remarks text [null]
  decided_by "bigint(20) unsigned" [null]
  decided_at timestamp [null]
  revoked_by "bigint(20) unsigned" [null]
  revoked_at timestamp [null]
  revoke_remarks text [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (absence_excuse_id, subject_offering_id) [unique, name: 'excuse_decisions_absence_excuse_id_subject_offering_id_unique']
    decided_by [name: 'excuse_decisions_decided_by_foreign']
    revoked_by [name: 'excuse_decisions_revoked_by_foreign']
    (subject_offering_id, status) [name: 'excuse_decisions_subject_offering_id_status_index']
  }
}

Table schedules {
  id "bigint(20) unsigned" [pk, increment, not null]
  subject_offering_id "bigint(20) unsigned" [not null]
  batch_id "bigint(20) unsigned" [null]
  term_id "bigint(20) unsigned" [not null]
  teacher_id "bigint(20) unsigned" [not null]
  room_id "bigint(20) unsigned" [null]
  mode schedules_mode [not null, default: 'onsite']
  starts_at datetime [not null]
  ends_at datetime [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    batch_id [name: 'schedules_batch_id_foreign']
    room_id [name: 'schedules_room_id_foreign']
    subject_offering_id [name: 'schedules_subject_offering_id_foreign']
    teacher_id [name: 'schedules_teacher_id_foreign']
  }

  Note: '''
  uq_schedules_teacher_slot: no two rows with the same (term_id, teacher_id) may overlap in period `slot` (MariaDB UNIQUE ... WITHOUT OVERLAPS)
  uq_schedules_room_slot: no two rows with the same (term_id, room_id) may overlap in period `slot` (MariaDB UNIQUE ... WITHOUT OVERLAPS)
  CHECK chk_schedules_reference_week: `starts_at` >= '2001-01-01 00:00:00' and `ends_at` < '2001-01-08 00:00:00'
  CHECK chk_schedules_room: `room_id` is not null or `mode` = 'online'
  CHECK chk_schedules_same_day: cast(`starts_at` as date) = cast(`ends_at` as date)
  '''
}

Table attendance_records {
  id "bigint(20) unsigned" [pk, increment, not null]
  enrollment_id "bigint(20) unsigned" [not null]
  schedule_id "bigint(20) unsigned" [not null]
  class_date date [not null]
  status attendance_records_status [not null]
  absence_excuse_id "bigint(20) unsigned" [null]
  recorded_by "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    absence_excuse_id [name: 'attendance_records_absence_excuse_id_foreign']
    recorded_by [name: 'attendance_records_recorded_by_foreign']
    (schedule_id, class_date) [name: 'attendance_records_schedule_id_class_date_index']
    (enrollment_id, schedule_id, class_date) [unique, name: 'uq_attendance_records_schedule_date']
  }

  Note: '''
  CHECK chk_attendance_records_excuse: `absence_excuse_id` is null or `status` = 'absent'
  '''
}

Table attendance_audits {
  id "bigint(20) unsigned" [pk, increment, not null]
  attendance_record_id "bigint(20) unsigned" [not null]
  changed_by "bigint(20) unsigned" [null]
  old_status attendance_audits_old_status [null]
  new_status attendance_audits_new_status [not null]
  old_absence_excuse_id "bigint(20) unsigned" [null]
  new_absence_excuse_id "bigint(20) unsigned" [null]
  changed_at timestamp [not null, default: `current_timestamp()`]

  indexes {
    (attendance_record_id, changed_at) [name: 'attendance_audits_attendance_record_id_changed_at_index']
    changed_by [name: 'attendance_audits_changed_by_foreign']
  }
}

Table term_registrations {
  id "bigint(20) unsigned" [pk, increment, not null]
  learner_id "bigint(20) unsigned" [not null]
  term_id "bigint(20) unsigned" [not null]
  year_level "tinyint(3) unsigned" [not null]
  section_id "bigint(20) unsigned" [null]
  is_irregular tinyint(1) [not null, default: 0]
  status term_registrations_status [not null, default: 'registered']
  registered_by "bigint(20) unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (learner_id, term_id) [unique, name: 'term_registrations_learner_id_term_id_unique']
    registered_by [name: 'term_registrations_registered_by_foreign']
    section_id [name: 'term_registrations_section_id_foreign']
    (term_id, section_id) [name: 'term_registrations_term_id_section_id_index']
  }
}

Ref absence_excuses_learner_id_foreign: absence_excuses.learner_id > learners.id [delete: restrict]
Ref absence_excuses_submitted_by_foreign: absence_excuses.submitted_by > users.id [delete: set null]
Ref absence_excuse_documents_absence_excuse_id_foreign: absence_excuse_documents.absence_excuse_id > absence_excuses.id [delete: cascade]
Ref absence_excuse_documents_uploaded_by_foreign: absence_excuse_documents.uploaded_by > users.id [delete: set null]
Ref attendance_audits_attendance_record_id_foreign: attendance_audits.attendance_record_id > attendance_records.id [delete: cascade]
Ref attendance_audits_changed_by_foreign: attendance_audits.changed_by > users.id [delete: set null]
Ref attendance_policies_term_id_foreign: attendance_policies.term_id - terms.id [delete: cascade]
Ref attendance_records_absence_excuse_id_foreign: attendance_records.absence_excuse_id > absence_excuses.id [delete: restrict]
Ref attendance_records_enrollment_id_foreign: attendance_records.enrollment_id > enrollments.id [delete: restrict]
Ref attendance_records_recorded_by_foreign: attendance_records.recorded_by > users.id [delete: set null]
Ref attendance_records_schedule_id_foreign: attendance_records.schedule_id > schedules.id [delete: restrict]
Ref batches_subject_offering_id_foreign: batches.subject_offering_id > subject_offerings.id [delete: cascade]
Ref calendar_events_college_id_foreign: calendar_events.college_id > colleges.id [delete: cascade]
Ref calendar_events_created_by_foreign: calendar_events.created_by > users.id [delete: set null]
Ref email_audits_changed_by_foreign: email_audits.changed_by > users.id [delete: set null]
Ref email_audits_user_id_foreign: email_audits.user_id > users.id [delete: cascade]
Ref email_changes_user_id_foreign: email_changes.user_id - users.id [delete: cascade]
Ref enrollments_batch_id_foreign: enrollments.batch_id > batches.id [delete: set null]
Ref enrollments_drop_confirmed_by_foreign: enrollments.drop_confirmed_by > users.id [delete: set null]
Ref enrollments_drop_dismissed_by_foreign: enrollments.drop_dismissed_by > users.id [delete: set null]
Ref enrollments_learner_id_foreign: enrollments.learner_id > learners.id [delete: restrict]
Ref enrollments_reinstated_by_foreign: enrollments.reinstated_by > users.id [delete: set null]
Ref enrollments_subject_offering_id_foreign: enrollments.subject_offering_id > subject_offerings.id [delete: restrict]
Ref excuse_decisions_absence_excuse_id_foreign: excuse_decisions.absence_excuse_id > absence_excuses.id [delete: cascade]
Ref excuse_decisions_decided_by_foreign: excuse_decisions.decided_by > users.id [delete: set null]
Ref excuse_decisions_revoked_by_foreign: excuse_decisions.revoked_by > users.id [delete: set null]
